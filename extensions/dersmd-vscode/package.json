{
  "name": "dersmd",
  "displayName": "DersMD",
  "description": "ders.json paketlerini doğrula (DersMD şeması)",
  "version": "0.1.0",
  "publisher": "dersmd",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Linters", "Education", "Other"],
  "activationEvents": [
    "onLanguage:json",
    "onCommand:dersmd.validatePackage"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dersmd.validatePackage",
        "title": "DersMD: Paketi Doğrula"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": ["**/content/courses/*.json", "**/*ders*.json"],
        "url": "./schemas/course.schema.json"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -p . -w",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/vscode": "^1.85.0",
    "typescript": "^5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rustemt/dersMD.git",
    "directory": "extensions/dersmd-vscode"
  }
}
