{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DersMD Course Package",
  "type": "object",
  "required": ["id", "title", "level", "minutes", "summary", "audience", "lessons"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "level": { "type": "string", "minLength": 1 },
    "minutes": { "type": "number", "exclusiveMinimum": 0 },
    "summary": { "type": "string" },
    "audience": { "type": "string" },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "minutes", "body", "quiz"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "minutes": { "type": "number" },
          "body": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "quiz": {
            "type": "object",
            "required": ["prompt", "choices", "answerIndex", "explain"],
            "properties": {
              "prompt": { "type": "string" },
              "choices": {
                "type": "array",
                "minItems": 2,
                "items": { "type": "string" }
              },
              "answerIndex": { "type": "integer", "minimum": 0 },
              "explain": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
